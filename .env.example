# Copy this file to ".env" and fill in your values.
# If AZDO_PAT is empty, the server runs in MOCK mode and generates sample data,
# so you can try the whole UI without touching Azure DevOps.

# Azure DevOps Personal Access Token (scope: Analytics - Read).
AZDO_PAT=

# Default organization + project used by all apps unless overridden per-app below.
AZDO_ORG=my-org
AZDO_PROJECT=my-project

# The 4 apps. Each maps a tab in the UI to a pipeline.
# Format: KEY|Display Name|PipelineName  (org/project optional: KEY|Name|Pipeline|org|project)
APP_1=app-a|Checkout Service|Checkout-CI
APP_2=app-b|Payments API|Payments-CI
APP_3=app-c|Web Frontend|Frontend-CI
APP_4=app-d|Notifications|Notifications-CI

# Workflow to query: Build or Release
AZDO_WORKFLOW=Build

# Server port
PORT=3001
